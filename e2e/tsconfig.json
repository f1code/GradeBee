{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode. Playwright transpiles each spec on its own through
       esbuild, so verbatimModuleSyntax earns its place: a per-file transpiler
       cannot tell that an imported name is only ever a type. */
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // playwright.config.ts is the one file whose breakage takes down all 35
  // tests rather than one spec, so it is worth the reach out of e2e/.
  "include": [".", "../playwright.config.ts"]
}
