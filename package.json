{
  "name": "gradebee",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "pnpm -F frontend dev",
    "dev:backend": "cd backend/cmd/server && go run .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "catalog:",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "catalog:"
  }
}
